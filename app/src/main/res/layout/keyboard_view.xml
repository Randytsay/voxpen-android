<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@color/keyboard_background"
    android:padding="4dp">

    <!-- Voice / refinement candidate area -->
    <LinearLayout
        android:id="@+id/candidate_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingTop="4dp"
        android:paddingBottom="4dp"
        android:visibility="gone">

        <LinearLayout
            android:id="@+id/translation_indicator_row"
            android:layout_width="match_parent"
            android:layout_height="28dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="4dp"
            android:paddingEnd="4dp"
            android:background="?android:attr/selectableItemBackground"
            android:visibility="gone">

            <TextView
                android:id="@+id/translation_label"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="@color/key_text"
                android:textSize="13sp"
                android:ellipsize="end"
                android:maxLines="1" />

            <ImageButton
                android:id="@+id/btn_translation_close"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/translation_close"
                android:src="@drawable/ic_close"
                android:scaleType="centerInside" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/candidate_status_row"
            android:layout_width="match_parent"
            android:layout_height="36dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:visibility="gone">

            <ProgressBar
                android:id="@+id/candidate_progress"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_marginEnd="8dp"
                android:visibility="gone"
                style="?android:attr/progressBarStyleSmall" />

            <TextView
                android:id="@+id/candidate_text"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="@color/key_text"
                android:textSize="15sp"
                android:ellipsize="end"
                android:maxLines="2" />

            <ImageButton
                android:id="@+id/btn_copy_status"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_marginStart="4dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/copy_to_clipboard"
                android:src="@drawable/ic_content_copy"
                android:scaleType="centerInside"
                android:visibility="gone" />
        </LinearLayout>

        <TextView
            android:id="@+id/candidate_original"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="6dp"
            android:textColor="#9E9E9E"
            android:textSize="13sp"
            android:drawablePadding="6dp"
            android:ellipsize="end"
            android:maxLines="2"
            android:background="?android:attr/selectableItemBackground"
            android:visibility="gone" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#33FFFFFF"
            android:layout_marginStart="6dp"
            android:layout_marginEnd="6dp" />

        <LinearLayout
            android:id="@+id/candidate_refined_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="6dp"
            android:background="?android:attr/selectableItemBackground"
            android:visibility="gone">

            <ProgressBar
                android:id="@+id/refine_progress"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_marginEnd="6dp"
                android:visibility="gone"
                style="?android:attr/progressBarStyleSmall" />

            <TextView
                android:id="@+id/candidate_refined"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="@color/key_text"
                android:textSize="15sp"
                android:textStyle="bold"
                android:ellipsize="end"
                android:maxLines="2" />

            <ImageButton
                android:id="@+id/btn_copy_refined"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_marginStart="4dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/copy_to_clipboard"
                android:src="@drawable/ic_content_copy"
                android:scaleType="centerInside"
                android:visibility="gone" />
        </LinearLayout>
    </LinearLayout>

    <!-- Container for toolbar and semi-transparent floating candidate window -->
    <FrameLayout
        android:id="@+id/toolbar_container"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:layout_marginTop="2dp"
        android:layout_marginBottom="2dp">

        <!-- Compact VoxPen toolbar matching the approved keyboard mockup. -->
        <LinearLayout
            android:id="@+id/voxpen_toolbar"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_gravity="center_vertical"
            android:orientation="horizontal"
            android:gravity="center"
            android:paddingStart="2dp"
            android:paddingEnd="2dp">

            <ImageButton
                android:id="@+id/btn_mic"
                android:layout_width="48dp"
                android:layout_height="38dp"
                android:layout_weight="0"
                android:background="@color/key_background"
                android:contentDescription="@string/keyboard_record"
                android:src="@drawable/ic_mic"
                android:padding="10dp"
                android:scaleType="centerInside"
                android:layout_margin="2dp" />

            <TextView
                android:id="@+id/btn_tone"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@color/key_background"
                android:gravity="center"
                android:textSize="20sp"
                android:text="語音"
                android:textColor="@color/key_text"
                android:layout_margin="2dp" />

            <TextView
                android:id="@+id/btn_edit_shortcut"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@color/key_background"
                android:gravity="center"
                android:text="編輯"
                android:textColor="@color/key_text"
                android:textSize="14sp"
                android:layout_margin="2dp" />

            <TextView
                android:id="@+id/btn_dictionary_shortcut"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@color/key_background"
                android:gravity="center"
                android:text="詞庫"
                android:textColor="@color/key_text"
                android:textSize="14sp"
                android:layout_margin="2dp" />

            <ImageButton
                android:id="@+id/btn_switch"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@color/key_background"
                android:contentDescription="@string/keyboard_switch"
                android:src="@drawable/ic_language"
                android:layout_margin="2dp" />

            <ImageButton
                android:id="@+id/btn_settings"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@color/key_background"
                android:contentDescription="@string/keyboard_settings"
                android:src="@drawable/ic_settings"
                android:layout_margin="2dp" />
        </LinearLayout>

        <!-- The code floats above candidates; neither row overlays the editor's composing text. -->
        <TextView
            android:id="@+id/hybrid_composition_code"
            android:layout_width="wrap_content"
            android:layout_height="22dp"
            android:layout_gravity="top|start"
            android:layout_marginStart="8dp"
            android:layout_marginTop="2dp"
            android:gravity="center"
            android:includeFontPadding="false"
            android:paddingStart="9dp"
            android:paddingEnd="9dp"
            android:textColor="#FFF4F5F8"
            android:textSize="12sp"
            android:fontFamily="monospace"
            android:elevation="8dp"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/hybrid_candidate_toolbar"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:layout_gravity="bottom"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:elevation="6dp"
            android:visibility="gone" />
    </FrameLayout>

    <!-- Hybrid Boshiamy + Pinyin text keyboard. It owns text composition locally. -->
    <com.voxpen.app.ime.hybrid.HybridKeyboardPanel
        android:id="@+id/hybrid_keyboard_panel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />
</LinearLayout>
